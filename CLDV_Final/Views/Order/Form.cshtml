@model OrderForm
@{ var editing = !string.IsNullOrEmpty(Model.Id); ViewData["Title"] = editing ? "Edit order" : "Create order"; }
<div class="page-heading"><div><p class="eyebrow">ORDERS</p><h1>@ViewData["Title"]</h1><p>Choose saved records. The server calculates the order total.</p></div></div>
<div class="panel form-panel"><form asp-action="@(editing ? "EditOrder" : "AddOrder")" method="post">
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
    <div class="form-field"><label asp-for="CustomerId"></label><select asp-for="CustomerId" class="form-select" required><option value="">Select a customer</option>@foreach(var customer in Model.Customers) { <option value="@customer.Id">@customer.Name</option> }</select><span asp-validation-for="CustomerId" class="field-error"></span></div>
    <div class="form-field"><label asp-for="ProductId"></label><select asp-for="ProductId" class="form-select" required><option value="">Select a product</option>@foreach(var product in Model.Products) { <option value="@product.Id">@product.Name — R @product.Price.ToString("N2")</option> }</select><span asp-validation-for="ProductId" class="field-error"></span></div>
    <div class="form-field"><label asp-for="Quantity"></label><input asp-for="Quantity" class="form-control" type="number" min="1" max="999" required /><span asp-validation-for="Quantity" class="field-error"></span></div>
    <div class="form-field"><label asp-for="OrderDate"></label><input asp-for="OrderDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required /><span asp-validation-for="OrderDate" class="field-error"></span></div>
    <p class="form-hint">Editing quantity keeps the order's recorded unit price. Selecting another product uses that product's current saved price.</p>
    <div class="actions"><button class="btn btn-primary" type="submit">Save order</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form></div>
