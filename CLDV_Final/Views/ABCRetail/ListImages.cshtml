@model IReadOnlyList<StoredFile>
@{ ViewData["Title"] = "Images"; }
<div class="page-heading"><div><p class="eyebrow">IMAGE LIBRARY</p><h1>Put a face to your products.</h1><p>Standalone uploads and product images, all in your own workspace.</p></div><a class="btn btn-primary" asp-action="UploadImage">Upload image</a></div>
<div class="product-grid">@foreach(var file in Model) { <article class="product-card"><div class="product-visual"><img src="@Url.Action("Image",new { id=file.Id })" alt="@file.Name" loading="lazy" /></div><div class="product-content"><h2 class="file-name">@file.Name</h2><p>@((file.Bytes.Length / 1024d).ToString("N1")) KB</p><form asp-action="DeleteImage" method="post"><input type="hidden" name="id" value="@file.Id" /><button class="btn btn-outline-danger btn-sm" type="submit">Delete image</button></form></div></article> }</div>
@if(Model.Count == 0) { <div class="panel empty-state">No images yet. Upload an image here or add one to a product.</div> }
