@{ ViewData["Title"] = "Upload contract"; }
<div class="page-heading"><div><p class="eyebrow">CONTRACTS</p><h1>Upload a sample contract.</h1><p>Use a fictional PDF, up to 2 MB. Avoid real personal or business documents.</p></div></div>
<div class="panel form-panel"><form asp-action="UploadContract" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-field"><label for="contractFile">PDF document</label><input id="contractFile" name="contractFile" type="file" class="form-control" accept="application/pdf,.pdf" required /></div><div class="actions"><button class="btn btn-primary" type="submit">Upload contract</button><a class="btn btn-outline-secondary" asp-action="ListContract">Cancel</a></div></form></div>
