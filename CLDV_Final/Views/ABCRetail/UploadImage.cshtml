@{ ViewData["Title"] = "Upload image"; }
<div class="page-heading"><div><p class="eyebrow">IMAGES</p><h1>Upload a sample image.</h1><p>Choose PNG, JPEG or WebP, up to 2 MB. To attach it to a product, use that product's edit page.</p></div></div>
<div class="panel form-panel"><form asp-action="UploadImage" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-field"><label for="imageFile">Image file</label><input id="imageFile" name="imageFile" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" required /></div><div class="actions"><button class="btn btn-primary" type="submit">Upload image</button><a class="btn btn-outline-secondary" asp-action="ListImages">Cancel</a></div></form></div>
