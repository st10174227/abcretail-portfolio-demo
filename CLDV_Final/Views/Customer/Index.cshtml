@model IReadOnlyList<CustomerEntity>
@{ ViewData["Title"] = "Customers"; }
<div class="page-heading"><div><p class="eyebrow">CUSTOMER DIRECTORY</p><h1>Know your customers.</h1><p>Fictional contacts for your sample orders.</p></div><a class="btn btn-primary" asp-action="AddCustomer">Add customer</a></div>
<div class="panel table-responsive"><table class="table"><caption class="visually-hidden">Customers in your demo workspace</caption><thead><tr><th>Name</th><th>Email</th><th>Actions</th></tr></thead><tbody>
@foreach(var customer in Model) { <tr><td><strong>@customer.Name</strong></td><td>@customer.Email</td><td class="table-actions"><a asp-action="EditCustomer" asp-route-id="@customer.Id">Edit</a><a class="danger-link" asp-action="DeleteCustomer" asp-route-id="@customer.Id">Delete<span class="visually-hidden"> @customer.Name</span></a></td></tr> }
@if(Model.Count == 0) { <tr><td colspan="3" class="empty-state">No customers yet. Add one to begin.</td></tr> }
</tbody></table></div>
