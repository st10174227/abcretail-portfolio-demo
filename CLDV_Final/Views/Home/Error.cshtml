@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<div class="panel reading-panel"><p class="eyebrow">PLEASE TRY AGAIN</p><h1>We couldn't complete that request.</h1><p>Return to the overview and try again. If your workspace expired, a fresh sample workspace will be created.</p>@if(Model.ShowRequestId) { <p class="subtle">Request reference: @Model.RequestId</p> }<a class="btn btn-primary" asp-action="Index">Back to overview</a></div>
