FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY CLDV_Final/CLDV_Final.csproj CLDV_Final/
RUN dotnet restore CLDV_Final/CLDV_Final.csproj
COPY CLDV_Final/ CLDV_Final/
RUN dotnet publish CLDV_Final/CLDV_Final.csproj --configuration Release --no-restore --output /app/publish /p:UseAppHost=false
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish/ ./
ENV ASPNETCORE_HTTP_PORTS=8080 ASPNETCORE_HTTPS_PORT=443 ABCRETAIL_DEMO_DATA_DIR=/tmp/abcretail-demo
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "CLDV_Final.dll"]
